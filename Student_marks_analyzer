#include <stdio.h>

int totalMarks(int marks[], int n) {
    int total = 0;

    for (int i = 0; i < n; i++) {
        total += marks[i];
    }

    return total;
}

int main() {
    int marks[5];
    int total;
    float percentage;

    printf("Enter marks of 5 subjects:\n");

    for (int i = 0; i < 5; i++) {
        printf("Subject %d: ", i + 1);
        scanf("%d", &marks[i]);
    }

    total = totalMarks(marks, 5);
    percentage = total / 5.0;

    printf("\n----- RESULT -----\n");
    printf("Total Marks : %d/500\n", total);
    printf("Percentage  : %.2f%%\n", percentage);

    if (percentage >= 90)
        printf("Grade: A+\n");
    else if (percentage >= 80)
        printf("Grade: A\n");
    else if (percentage >= 70)
        printf("Grade: B\n");
    else if (percentage >= 60)
        printf("Grade: C\n");
    else
        printf("Grade: Needs Improvement\n");

    return 0;
}
